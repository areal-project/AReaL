# Copy to bindings.env beside ray.env, outside the checkout.
qwen_3d_bindings_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# Four upstream streams, each dispatched through both pinned harness versions.
QWEN_3D_STREAM_1=  # Heritage component / color
QWEN_3D_STREAM_2=  # Component split / white
QWEN_3D_STREAM_3=  # Component split / color
QWEN_3D_STREAM_4=  # Component split / color, second set
QWEN_3D_HARNESS_NOSKILL=  # Full harness name@version
QWEN_3D_HARNESS_SELF_IMPLEMENT=  # Full harness name@version
# Copy frozen per-data_id reward_ref key/version JSON mappings into this folder.
# Each pair of harness variants shares its upstream stream's mapping.
QWEN_3D_REWARD_MAP_1="$qwen_3d_bindings_dir/reward-mappings/stream-1.json"
QWEN_3D_REWARD_MAP_2="$qwen_3d_bindings_dir/reward-mappings/stream-2.json"
QWEN_3D_REWARD_MAP_3="$qwen_3d_bindings_dir/reward-mappings/stream-3.json"
QWEN_3D_REWARD_MAP_4="$qwen_3d_bindings_dir/reward-mappings/stream-4.json"
# Legacy single-stream overrides conflict with the eight-stream configuration.
unset QWEN_ARENA_STREAM_ID QWEN_ARENA_HARNESS QWEN_REWARD_KEY QWEN_REWARD_VERSION
