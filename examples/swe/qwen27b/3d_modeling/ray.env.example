# Copy to ray.env in a deployment directory outside the checkout.
# Move the whole directory to another machine; paths below follow this file.
qwen_3d_profile_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# Optional local credentials file, or inherit the site's existing environment.
if [[ -f "$qwen_3d_profile_dir/credentials.env" ]]; then
  source "$qwen_3d_profile_dir/credentials.env"
fi
source "$qwen_3d_profile_dir/bindings.env"

# Set the model path and OCI images for the DESTINATION cluster.
QWEN_MODEL=${QWEN_MODEL:-}
QWEN_RAY_ACTOR_IMAGE=${QWEN_RAY_ACTOR_IMAGE:-}
QWEN_RAY_ROLLOUT_IMAGE=${QWEN_RAY_ROLLOUT_IMAGE:-}
QWEN_RAY_PYTHON=${QWEN_RAY_PYTHON:-python3}
QWEN_RAY_ACTOR_PYTHON=${QWEN_RAY_ACTOR_PYTHON:-python3}
QWEN_RAY_ROLLOUT_PYTHON=${QWEN_RAY_ROLLOUT_PYTHON:-python3}
QWEN_RAY_ACTOR_PYTHONPATH=${QWEN_RAY_ACTOR_PYTHONPATH:-}
QWEN_RAY_ROLLOUT_PYTHONPATH=${QWEN_RAY_ROLLOUT_PYTHONPATH:-}
RAY_ADDRESS=${RAY_ADDRESS:-auto}
QWEN_EXPERIMENT_NAME=${QWEN_EXPERIMENT_NAME:-qwen27-blender-ray}
# Change the trial for a fresh experiment or changed training configuration.
QWEN_ARENA_TRIAL=${QWEN_ARENA_TRIAL:-blender-bs64-gs12-001}
QWEN_OUTPUT_ROOT=${QWEN_OUTPUT_ROOT:-$qwen_3d_profile_dir/output}
QWEN_RUN_DIR=${QWEN_RUN_DIR:-$QWEN_OUTPUT_ROOT/$QWEN_ARENA_TRIAL}
SGLANG_VLM_QWEN_LIMIT_PIXEL=true
AREAL_VLM_ALIGN_SGLANG=true
