# Copy to site.env (keep it Git-ignored), or use an external profile.
# Paths must be visible at the same location in every role's container.
QWEN_REPO=
QWEN_OUTPUT_ROOT=/storage/openpsi/experiments
QWEN_MODEL=
QWEN_EXPERIMENT_NAME=sxj-qwen38-graybox19-rl
# Generate once at submission; set QWEN_ARENA_TRIAL explicitly when recovering.
QWEN_ARENA_TRIAL=${QWEN_ARENA_TRIAL:-$(date +%m%d-%H%M)-8n-256k-bs16-gs12-token-mean-whitebox64-std}
# Config snapshot and preflight reports, separate from logs and checkpoints.
QWEN_RUN_DIR="$QWEN_OUTPUT_ROOT/${QWEN_RUN_USER:-$(id -un)}/$QWEN_EXPERIMENT_NAME/$QWEN_ARENA_TRIAL"
# Optional shared snapshot directory; defaults to $QWEN_RUN_DIR/source.
QWEN_SYNC_DIR=
QWEN_PARTITION=
QWEN_RESERVATION=
QWEN_NODELIST=
QWEN_CONTROLLER_NODE=
QWEN_MOUNTS=
# Include host Slurm configuration/client binaries and Munge socket/libraries.
QWEN_CONTROLLER_MOUNTS=
# Verified actor image filename: areal-dev-sglang-0821.sif.
QWEN_ACTOR_IMAGE=
# Verified inference image filename: deepep-base-85b53914.sif.
QWEN_ROLLOUT_IMAGE=
# Historical runtime containing dependencies/ and aweagent/.
# Megatron-Core 0.18.2, megatron-bridge 0.5.1.
QWEN_DENSE_RUNTIME=
# Installed AWEX 0.8.2 root containing awex/models/qwen3_5.py.
AWEX_RUNTIME_ROOT=
# Actor image site-packages plus the matching AEnv Python 3.12 package root.
QWEN_ACTOR_EXTRA_PYTHONPATH=
# Existing rollout dependency and proxy-deps roots; SGLang remains in the SIF.
QWEN_ROLLOUT_RUNTIME_DEPS=
QWEN_PROXY_DEPS=
QWEN_INFER_EXTRA_PYTHONPATH=
MEGATRON_ROOT=
# Fill the URLs and tokens for the same Arena deployment.
ARENA_OPENAPI_BASE=
ARENA_OPENAPI_TOKEN=
ARENA_LLM_API_KEY=
PRM_JUDGE_API_KEY=
WANDB_BASE_URL=
WANDB_API_KEY=
