# Copy outside the checkout and source your existing private environment here.
# All paths, including this profile, must be available on every Ray node.
# source /shared/private/arena.env
QWEN_MODEL=
QWEN_OUTPUT_ROOT=
QWEN_EXPERIMENT_NAME=qwen38-27b-arena-rl
# Set explicitly once; use a fresh trial for a new experiment.
QWEN_ARENA_TRIAL=
QWEN_RUN_DIR=

# Select the existing cluster. "auto" fails if none is available.
RAY_ADDRESS=auto
# Controller interpreter (in the environment where you submit the driver).
QWEN_RAY_PYTHON=python3
# OCI image references, not SIF paths. Empty means inherit the Ray node environment.
QWEN_RAY_ACTOR_IMAGE=
QWEN_RAY_ROLLOUT_IMAGE=
# Native interpreter path INSIDE each role image; these need not be identical.
# Select the image's actual virtualenv Python when its packages live in a venv.
QWEN_RAY_ACTOR_PYTHON=python3
QWEN_RAY_ROLLOUT_PYTHON=python3
# Optional dependency overlays; leave empty when installed in the image.
QWEN_RAY_ACTOR_PYTHONPATH=
QWEN_RAY_ROLLOUT_PYTHONPATH=

# The default bs16/gs12 preset reads these explicit stream/reward references.
QWEN_ARENA_STREAM_ID=
QWEN_ARENA_HARNESS=
QWEN_REWARD_KEY=
QWEN_REWARD_VERSION=

# Keep proxy and SGLang image processing aligned with the reference run.
SGLANG_VLM_QWEN_LIMIT_PIXEL=true
AREAL_VLM_ALIGN_SGLANG=true
# Supply these through the existing private environment, not a committed file:
# ARENA_OPENAPI_BASE, ARENA_OPENAPI_TOKEN, ARENA_LLM_API_KEY,
# WANDB_BASE_URL, WANDB_API_KEY (and optional WANDB_ENTITY, PRM_JUDGE_API_KEY).
